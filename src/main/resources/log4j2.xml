<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for the app's own process: warnings and errors only, on stderr, so the CLI's
     stdout stays clean. The forked Tika parser has its own file, tika-fork-log4j2.xml. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="console" target="SYSTEM_ERR">
      <PatternLayout pattern="%-5p %c{1}: %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <!-- Tika warns about a missing plugins folder at every start; plugins come from the class path. -->
    <Logger name="org.apache.tika" level="error"/>
    <!-- Lucene (through java.util.logging) suggests enabling the vector incubator module at every start. -->
    <Logger name="org.apache.lucene" level="error"/>
    <!-- LangChain4j logs a stack trace for every retried request; the CLI reports the final
         error itself, in the user's terms. -->
    <Logger name="dev.langchain4j" level="error"/>
    <!-- The embedding model's tokenizer warns at every load that it uses the model's own length limit. -->
    <Logger name="ai.djl" level="error"/>
    <Root level="warn">
      <AppenderRef ref="console"/>
    </Root>
  </Loggers>
</Configuration>
