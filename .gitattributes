# Normalize line endings; scripts that bash runs must keep LF even on Windows.
* text=auto
gradlew text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
*.bat text eol=crlf

*.jar binary
*.pdf binary
*.docx binary
*.pptx binary
*.png binary

# Test files must stay byte-for-byte identical on every OS (content hashes, page offsets).
testdata/corpus/** -text
