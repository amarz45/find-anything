+remove(path: Path)
+commit()
+refresh()
+getFile(file: Path): Optional&lt;IndexedFile&gt;
+getChunks(file: Path): List&lt;Chunk&gt;
+getChunksOfContent(contentHash: String): List&lt;Chunk&gt;
+findContentWithoutEmbeddings(limit: int): List&lt;String&gt;
+countChunksWithoutEmbeddings(): int
+findFilesWithoutNameEmbeddings(limit: int): List&lt;Path&gt;
+keywordSearch(query: String, searchFilters: SearchFilters, limit: int): List&lt;ChunkHit&gt;
+vectorSearch(queryVector: float[], searchFilters: SearchFilters, limit: int): List&lt;ChunkHit&gt;
+listFiles(searchFilters: SearchFilters, limit: int): List&lt;IndexedFile&gt;</panel_attributes>
