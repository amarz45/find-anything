    <panel_attributes>SearchIndex
--
-indexDirectory: Path
-mode: IndexMode
--
_+open(indexDirectory: Path): SearchIndex_
+getMode(): IndexMode
+put(file: IndexedFile, chunks: List&lt;Chunk&gt;)
+addEmbeddings(contentHash: String, vectors: List&lt;float[]&gt;)
