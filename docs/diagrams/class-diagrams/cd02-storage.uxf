    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>1530</x>
      <y>160</y>
      <w>370</w>
      <h>60</h>
    </coordinates>
    <panel_attributes>Must be thread-safe: the indexing worker embeds
chunks while background threads embed queries.</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
