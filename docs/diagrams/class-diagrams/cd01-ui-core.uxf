    <panel_attributes>&lt;&lt;Facade&gt;&gt;
FindAnythingService
--
-indexConfig: IndexConfig
-settingsStore: SettingsStore
-searchIndex: SearchIndex
-indexMode: IndexMode
-modelSettings: ModelSettings
-indexer: Indexer
-fileWatcher: FileWatcher
-searchEngine: SearchEngine
-documentComparator: DocumentComparator
-agentController: AgentController
-conversationStore: ConversationStore
-llmClientFactory: LlmClientFactory
-folderPolicy: FolderPolicy
-redactor: Redactor
-privacyLog: PrivacyLog
-backgroundExecutor: ExecutorService
--
+open(watchFiles: boolean): IndexMode
+close()
+addSearchFolder(folder: Path): SearchFolder
+removeSearchFolder(folder: Path)
+setFolderPaused(folder: Path, paused: boolean)
+addExclusion(pattern: String, folder: Path)
+search(query: String, searchFilters: SearchFilters): CompletableFuture&lt;List&lt;SearchResult&gt;&gt;
+ask(request: String, conversation: Conversation, progressListener: Consumer&lt;String&gt;): CompletableFuture&lt;Answer&gt;
+compare(oldFile: Path, newFile: Path): CompletableFuture&lt;Comparison&gt;
+preview(file: Path, highlight: String): CompletableFuture&lt;Preview&gt;
+newConversation(): Conversation
+listConversations(): List&lt;Conversation&gt;
+openConversation(id: String): Conversation
+testBackend(modelSettings: ModelSettings): CompletableFuture&lt;Boolean&gt;
+setBackend(modelSettings: ModelSettings)
+setLocalOnly(folder: Path, localOnly: boolean)
+setRedaction(category: String, enabled: boolean)
+getPrivacyLog(limit: int): List&lt;PrivacyLogEntry&gt;
+getIndexStatus(): IndexStatus
+rebuildIndex()
+addStatusListener(listener: IndexStatusListener)</panel_attributes>
