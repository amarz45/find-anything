# Copy this file to .env (which git ignores) and fill in your own values:
#   cp .env.example .env
# Never put real keys in any other file, commit, screenshot, log, or video.

# Cloud model through OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# Model ID exactly as listed on https://openrouter.ai/models (must support tool calling).
OPENROUTER_MODEL=YOUR_MODEL_ID_HERE

# Local model through Ollama. Use the desktop's Tailscale name instead of localhost
# when the laptop uses the desktop's Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=YOUR_OLLAMA_MODEL_HERE
