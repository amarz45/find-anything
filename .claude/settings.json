{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "mcp__intellij-index__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config.local.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  },
  "cleanupPeriodDays": 3650,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if git status --porcelain -- '*.java' | grep -q .; then ./gradlew --quiet spotlessApply; fi"
          }
        ]
      }
    ]
  }
}
